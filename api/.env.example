# Copy to .env.local. Never commit actual secrets.
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_HOST=postgres
DB_PORT=5432
DB_NAME=guitar_practice
DB_USER=guitar_api
# Match GUITAR_API_PASSWORD from the running DB, not POSTGRES_PASSWORD.
DB_PASSWORD='replace-with-the-api-role-password'
# Desktop OAuth client ID from Google Cloud (not the client secret).
GOOGLE_OAUTH_CLIENT_ID=
