          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get(\"next_cursor_encoded\")) { pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              " const data = pm.response.json();",
              " pm.test(\"Different next page\", () => data.items.forEach(s => pm.expect(s.score_id).not.to.eql(pm.environment.get(\"sync_score_id\"))));",
              " pm.environment.set(\"next_cursor_encoded\", data.next_cursor ? encodeURIComponent(data.next_cursor) : \"\");",
              "}"
            ]
          }
        }
      ]
    }
