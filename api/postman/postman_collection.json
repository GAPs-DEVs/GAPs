    {
      "name": "11 Sync library (first page)",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{base_url}}/api/scores/sync?limit=1"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset(\"sync_score_id\");",
              "pm.environment.unset(\"sync_version_id\");",
              "pm.environment.unset(\"next_cursor_encoded\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              " const data = pm.response.json();",
              " pm.test(\"Library page\", () => { pm.expect(data.items).to.be.an(\"array\"); pm.expect(data.items.length).to.be.at.most(1); });",
              " pm.environment.set(\"next_cursor_encoded\", data.next_cursor ? encodeURIComponent(data.next_cursor) : \"\");",
              " const score = data.items.find(item => item.selected_version_id);",
              " if (score) { pm.environment.set(\"sync_score_id\", score.score_id); pm.environment.set(\"sync_version_id\", score.selected_version_id); }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Selected version content",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{base_url}}/api/scores/{{sync_score_id}}/versions/{{sync_version_id}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get(\"sync_score_id\") || !pm.environment.get(\"sync_version_id\")) { pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              " const data = pm.response.json();",
              " pm.test(\"Selected IDs\", () => { pm.expect(data.score_id).to.eql(pm.environment.get(\"sync_score_id\")); pm.expect(data.version_id).to.eql(pm.environment.get(\"sync_version_id\")); });",
              " pm.test(\"Notes and ordering\", () => {",
              "  pm.expect(data.notes).to.be.an(\"array\");",
              "  data.notes.forEach((n, i) => {",
              "   pm.expect(n.score_step_id).to.be.a(\"string\");",
              "   if (i) { const prev = data.notes[i - 1]; pm.expect(n.step > prev.step || (n.step === prev.step && n.string > prev.string)).to.eql(true); }",
              "  });",
              " });",
              "}"
            ]
          }
        }
      ]
    },
