{
  "info": {
    "name": "Guitar Practice API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order after deploying the API. Successful upload creates a private score each time. No automatic cleanup or retries. SSL verification must remain enabled."
  },
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": "{{base_url}}/health/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Healthy\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 DB health",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": "{{base_url}}/health/db/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"DB available\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Google login → save service token",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/google",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_token\": \"{{google_id_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Clear old results so a failed login cannot reuse an earlier session.",
              "pm.environment.unset(\"access_token\");",
              "pm.environment.unset(\"user_id\");",
              "if (!pm.environment.get(\"google_id_token\")) { throw new Error(\"Run the local token helper and import its environment first.\"); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test(\"Service token and user\", () => { pm.expect(data.access_token).to.be.a(\"string\").and.not.empty; pm.expect(data.user.id).to.be.a(\"string\"); });",
              "  if (data.access_token && data.user && data.user.id) {",
              "    pm.environment.set(\"access_token\", data.access_token);",
              "    pm.environment.set(\"user_id\", data.user.id);",
              "    pm.environment.unset(\"google_id_token\");",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Authenticated user",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{base_url}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Same user\", () => pm.expect(pm.response.json().user.id).to.eql(pm.environment.get(\"user_id\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Upload private score (creates one DB record)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/scores",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman upload {{$timestamp}}\",\n  \"source_type\": \"import\",\n  \"notes\": [\n    {\n      \"step\": 1,\n      \"string\": 1,\n      \"fret\": 0,\n      \"duration_ms\": 500,\n      \"midi_pitch\": 64\n    },\n    {\n      \"step\": 1,\n      \"string\": 2,\n      \"fret\": 1,\n      \"duration_ms\": 500,\n      \"midi_pitch\": 60\n    },\n    {\n      \"step\": 2,\n      \"string\": 1,\n      \"fret\": 3,\n      \"duration_ms\": 500,\n      \"midi_pitch\": 67\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset(\"score_id\");",
              "pm.environment.unset(\"version_id\");",
              "if (!pm.environment.get(\"access_token\")) { throw new Error(\"Send Google login first.\"); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const score = pm.response.json().score;",
              "  pm.test(\"Private version 1, 3 notes, 2 steps\", () => {",
              "    pm.expect(score.visibility).to.eql(\"private\"); pm.expect(score.version_number).to.eql(1);",
              "    pm.expect(score.note_count).to.eql(3); pm.expect(score.step_count).to.eql(2);",
              "    pm.expect(score.id).to.match(/^[0-9a-f-]{36}$/);",
              "  });",
              "  pm.environment.set(\"score_id\", score.id);",
              "  pm.environment.set(\"version_id\", score.version_id);",
              "}"
            ]
          }
        }
      ]
    },
