-- Run this as the PostgreSQL administrator or the current owner of the public schema.
-- It intentionally transfers the application schema to the migration role.
-- This file assumes the role names documented in db/README.md:
--   migration owner: guitar_migrator
--   running API:     guitar_api
-- Create roles and set their passwords outside this repository.

ALTER SCHEMA public OWNER TO guitar_migrator;
REVOKE CREATE ON SCHEMA public FROM PUBLIC;

GRANT CONNECT ON DATABASE guitar_practice TO guitar_api;
GRANT USAGE ON SCHEMA public TO guitar_api;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO guitar_api;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO guitar_api;

-- Apply the same data permissions automatically to tables created by later migrations.
ALTER DEFAULT PRIVILEGES FOR ROLE guitar_migrator IN SCHEMA public
    GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO guitar_api;

ALTER DEFAULT PRIVILEGES FOR ROLE guitar_migrator IN SCHEMA public
    GRANT USAGE, SELECT ON SEQUENCES TO guitar_api;
