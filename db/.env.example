# Local development only. Copy this file to db/.env.local and set strong passwords.
# Do not commit db/.env.local or a production DATABASE_URL.

# The Docker Compose bootstrap user. Keep this name unless the SQL role examples
# and grant_api_role.sql.example are updated together.
POSTGRES_DB=guitar_practice
POSTGRES_USER=guitar_migrator
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# API runtime account. It is created only when Docker initializes a new volume.
GUITAR_API_USER=guitar_api
GUITAR_API_PASSWORD=replace-with-a-different-local-development-password

# Used by psql, migration jobs, or a future backend ORM.
DATABASE_URL=postgresql://guitar_migrator:replace-with-a-local-development-password@127.0.0.1:5432/guitar_practice
